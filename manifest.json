{
  "manifest_version": 3,
  "name": "SteamDB 中文汉化",
  "short_name": "SteamDB CN",
  "version": "1.0.1",
  "description": "将 SteamDB 网页界面翻译为简体中文。本地词库、非官方、不收集任何数据。",
  "content_scripts": [
    {
      "matches": ["https://steamdb.info/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["translations.zh-CN.json"],
      "matches": ["https://steamdb.info/*"]
    }
  ]
}
